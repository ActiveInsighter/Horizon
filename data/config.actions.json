{
  "ai": {
    "provider": "openai",
    "model": "${HORIZON_AI_MODEL}",
    "base_url": "${HORIZON_AI_BASE_URL}",
    "api_key_env": "OPENAI_API_KEY",
    "languages": [
      "zh",
      "en"
    ],
    "temperature": 0.3,
    "max_tokens": 4096,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "throttle_sec": 1.0
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 10,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [],
    "github": [],
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "ossinsight": {
      "enabled": false
    },
    "twitter": {
      "enabled": true,
      "mode": "apify",
      "apify_token_env": "APIFY_TOKEN",
      "actor_id": "altimis~scweet",
      "users": [
        "OpenAI",
        "OpenAIDevs",
        "ChatGPTapp",
        "AnthropicAI",
        "claudeai"
      ],
      "keywords": [],
      "fetch_limit": 100,
      "fetch_reply_text": true,
      "profile": "tech-news",
      "batch_discussions": true,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 6,
      "reply_min_likes": 5,
      "apify_max_total_charge_usd": 0.04
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 6
  },
  "display": {
    "icon_style": "emoji"
  }
}
